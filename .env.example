# Server Configuration
PORT=3000
NODE_ENV=development

# Google Cloud Storage (Public Bucket - No Auth Required)
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-video-bucket-name
# Note: Bucket must be publicly readable. No key file needed.

# Buffer API
BUFFER_ACCESS_TOKEN=your-buffer-access-token
BUFFER_PROFILE_ID=your-instagram-profile-id

# Video Processing
TEMP_DIR=./tmp
