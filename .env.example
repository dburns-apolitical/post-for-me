# Server Configuration
PORT=3000
NODE_ENV=development

# Google Cloud Storage
GCS_PROJECT_ID=your-gcp-project-id
# Note: Per-account settings (IG tokens, user IDs, GCS bucket names) are managed via the API/DB.
# On first run, INSTAGRAM_ACCESS_TOKEN_1/2, INSTAGRAM_USER_ID_1/2, and GCS_BUCKET_NAME
# env vars are used to seed the DB. After that, they are no longer needed.

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Temp directory for video processing
TEMP_DIR=./tmp

# Dashboard Authentication
# Password for accessing the /api/stats endpoint
DASHBOARD_PASSWORD=your-secure-dashboard-password

# You can keep the NEON_AUTH_URL for reference, or just use NEON_JWKS_URL
NEON_AUTH_URL=www.url.com

# The code will automatically derive the JWKS URL from NEON_AUTH_URL:
# https://www.url.com

ANTHROPIC_API_KEY=mhgfg.jkhg,