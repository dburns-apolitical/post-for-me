# Server Configuration
PORT=3000
NODE_ENV=development

# Google Cloud Storage (Public Bucket)
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-video-bucket-name

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_USER_ID=your-instagram-user-id

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Temp directory for video processing
TEMP_DIR=./tmp

# Dashboard Authentication
# Password for accessing the /api/stats endpoint
DASHBOARD_PASSWORD=your-secure-dashboard-password

# Optional: Neon Auth URL for JWT validation (if using Neon Auth on frontend)
# NEON_AUTH_URL=https://your-project.neon.tech/auth
