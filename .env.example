# Server Configuration
PORT=3000
NODE_ENV=development

# Google Cloud Storage (Public Bucket - No Auth Required)
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-video-bucket-name
# Note: Bucket must be publicly readable. No key file needed.

# Instagram API
INSTAGRAM_ACCESS_TOKEN=your-ig-access-token
INSTAGRAM_USER_ID=your-ig-user-id

# Video Processing
TEMP_DIR=./tmp

# Database connection string
DATABASE_URL=postgresql://test:test@localhost/test
