{
  "name": "post-for-me",
  "version": "1.0.0",
  "description": "Automated Instagram Reels posting service",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "docker:build": "docker build -t post-for-me .",
    "docker:run": "docker run -p 3000:3000 --env-file .env post-for-me",
    "docker:test": "./scripts/test-docker.sh"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@langchain/anthropic": "^1.3.17",
    "@langchain/core": "^1.1.24",
    "@neondatabase/serverless": "^1.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "jose": "^5.2.0",
    "langchain": "^1.2.24",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fluent-ffmpeg": "^2.1.26"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "instagram",
    "reels",
    "automation",
    "buffer",
    "video",
    "social-media"
  ],
  "author": "Your Name",
  "license": "MIT"
}
